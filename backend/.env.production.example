# .env.production.example — template for production environment
# In production, prefer injecting these via your platform's secret manager
# (Railway, Render, AWS SSM, Docker secrets, Kubernetes secrets)
# Never store real production values in any file in the repository

NODE_ENV=production
PORT=4000

# Production PostgreSQL — use connection pooler (PgBouncer) in front of Postgres
DATABASE_URL=postgresql://finance_user:PROD_DB_PASSWORD@prod-db-host:5432/finance_prod
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20
DATABASE_SSL=true

# Generate UNIQUE secrets for production — never reuse development/staging secrets
JWT_ACCESS_SECRET=PROD_GENERATED_SECRET_64_HEX
JWT_REFRESH_SECRET=PROD_GENERATED_DIFFERENT_SECRET_64_HEX
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Production Redis with TLS (rediss://)
REDIS_URL=rediss://prod-redis-host:6380

# Production frontend URL (no trailing slash)
FRONTEND_URL=https://yourapp.com

# Higher bcrypt rounds in production
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_API_MAX=200

SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=PROD_SENDGRID_API_KEY
EMAIL_FROM=noreply@yourapp.com

EXCHANGE_RATE_API_KEY=PROD_EXCHANGE_RATE_KEY
