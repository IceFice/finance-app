# .env.staging.example — template for staging environment
# Copy to .env on the staging server and fill in real values
# Never commit this file with real values

NODE_ENV=staging
PORT=4000

# Point to staging PostgreSQL instance
DATABASE_URL=postgresql://finance_user:STAGING_DB_PASSWORD@staging-db-host:5432/finance_staging
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_SSL=true

# Generate fresh secrets for staging (separate from production!)
JWT_ACCESS_SECRET=STAGING_GENERATED_SECRET_64_HEX
JWT_REFRESH_SECRET=STAGING_GENERATED_DIFFERENT_SECRET_64_HEX
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Staging Redis (can be same server, different DB index)
REDIS_URL=rediss://staging-redis-host:6380

# Staging frontend URL
FRONTEND_URL=https://staging.yourapp.com

BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_API_MAX=200

SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@staging.yourapp.com
SMTP_PASS=STAGING_SMTP_PASSWORD
EMAIL_FROM=noreply@staging.yourapp.com

EXCHANGE_RATE_API_KEY=STAGING_EXCHANGE_RATE_KEY
