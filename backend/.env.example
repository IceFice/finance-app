# ============================================================
# .env.example — copy to .env and fill in real values
# Run `npm run generate-secrets` to generate JWT secrets
# DO NOT commit .env to version control
# ============================================================

# ── Runtime ───────────────────────────────────────────────
NODE_ENV=development
# Port the Express server listens on
PORT=4000

# ── Database ──────────────────────────────────────────────
# Full PostgreSQL connection string
DATABASE_URL=postgresql://finance_user:YOUR_DB_PASSWORD@localhost:5432/finance_db
# Connection pool — min should be ≥1, max depends on Postgres max_connections
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
# Set to true in production when using SSL (RDS, Supabase, etc.)
DATABASE_SSL=false

# ── JWT ───────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Or run: npm run generate-secrets
JWT_ACCESS_SECRET=REPLACE_WITH_64_HEX_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_HEX_CHARS
# Access token lifetime — keep short (15m recommended)
JWT_ACCESS_EXPIRES_IN=15m
# Refresh token lifetime — stored in HttpOnly cookie
JWT_REFRESH_EXPIRES_IN=30d

# ── Redis ─────────────────────────────────────────────────
# Used for rate limiting and session blacklist
# Production: use rediss:// for TLS
REDIS_URL=redis://localhost:6379

# ── CORS ─────────────────────────────────────────────────
# URL of the frontend — no trailing slash
FRONTEND_URL=http://localhost:5173

# ── Security ─────────────────────────────────────────────
# bcrypt cost factor — 12 is safe default, max 14 for production
BCRYPT_ROUNDS=12
# Rate limiting window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Max auth attempts (login/register) per window per IP
RATE_LIMIT_AUTH_MAX=5
# Max general API requests per window per user
RATE_LIMIT_API_MAX=200

# ── Email (for password reset) ────────────────────────────
# Leave blank to disable email features in development
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ── External APIs ─────────────────────────────────────────
# Exchange rate API key (for multi-currency support)
EXCHANGE_RATE_API_KEY=
