# ============================================================
# Production env — copy to /opt/finance-app/.env on the VPS and fill in.
# Read by docker-compose.prod.yml (interpolation) AND by the backend
# container (env_file). NEVER commit the real file.
#
#   cp deploy/.env.production.example /opt/finance-app/.env
#   nano /opt/finance-app/.env
# ============================================================

# ── Images (overwritten by the CD pipeline on each deploy) ──────────────────
BACKEND_IMAGE=ghcr.io/icefice/finance-app/backend:latest
FRONTEND_IMAGE=ghcr.io/icefice/finance-app/frontend:latest

# ── Public domain (used by enable-ssl.sh and CORS) ──────────────────────────
DOMAIN=example.com

# ── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# ── PostgreSQL (container — credentials only used inside the bridge net) ─────
POSTGRES_USER=finance_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=finance_db
# DATABASE_URL/REDIS_URL are derived in docker-compose.prod.yml from the
# values above; do not set them here. Traffic stays on the internal docker
# network, so DATABASE_SSL stays false.
DATABASE_SSL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ── JWT secrets — generate UNIQUE production values ─────────────────────────
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_64_HEX_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_HEX_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Security ────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_API_MAX=200

# ── CORS — exact production origin, no trailing slash ───────────────────────
# Use https://YOUR_DOMAIN once SSL is enabled; http://VPS_IP before that.
FRONTEND_URL=https://example.com

# ── Email (optional — password reset) ───────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ── External APIs (optional) ────────────────────────────────────────────────
EXCHANGE_RATE_API_KEY=
